{
  "name": "faircount",
  "version": "1.1.0",
  "description": "An honest estimate of how many distinct values a stream contains — the unbiased CVM variant, with proven (ε, δ) error bounds and a sample of bounded size. One estimator, fed directly or from any source, in memory or streamed.",
  "type": "module",
  "main": "./src/index.mjs",
  "module": "./src/index.mjs",
  "types": "./types/index.d.mts",
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "import": "./src/index.mjs",
      "default": "./src/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "bench": "node bench/index.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test",
    "typecheck": "tsc -p typecheck"
  },
  "keywords": [
    "cvm",
    "distinct",
    "count-distinct",
    "unique-count",
    "cardinality",
    "streaming",
    "stream",
    "sketch",
    "estimation",
    "estimator",
    "unbiased",
    "probabilistic",
    "hyperloglog"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mauro-d/faircount.git"
  },
  "homepage": "https://github.com/mauro-d/faircount#readme",
  "bugs": {
    "url": "https://github.com/mauro-d/faircount/issues"
  },
  "author": "Mauro <mauro.doganieri@gmail.com>",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "^9.39.5",
    "neostandard": "^0.13.0",
    "typescript": "^5.9.3"
  }
}
